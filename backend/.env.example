# Copy to .env and fill in.

PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Firebase Admin SDK — Firebase Console > Project Settings > Service Accounts >
# "Generate new private key". Save the downloaded JSON file as backend/serviceAccountKey.json
# (already gitignored) and leave this pointing at it, OR paste the JSON contents into
# FIREBASE_SERVICE_ACCOUNT_JSON instead (handy for cloud deploys where you can't ship a file).
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# Envelope-encryption key for stored GST portal credentials. Generate with:
#   node -e "console.log('base64:' + require('crypto').randomBytes(32).toString('base64'))"
# Must match the value nowhere else — only the backend ever encrypts/decrypts.
CREDENTIAL_MASTER_KEY=base64:REPLACE_WITH_32_BYTE_KEY

# Gmail SMTP for the monthly document-request emails (via Nodemailer).
# GMAIL_USER: the Gmail address to send from.
# GMAIL_APP_PASSWORD: NOT your normal Gmail password — Google Account > Security >
# 2-Step Verification (must be on) > App passwords > generate one for "Mail".
GMAIL_USER=
GMAIL_APP_PASSWORD=
