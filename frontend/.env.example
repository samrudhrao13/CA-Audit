# Copy to .env.local and fill in from Firebase Console > Project Settings > General >
# "Your apps" > Web app > SDK setup and configuration (the config object shown there).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

VITE_API_URL=http://localhost:4000

# Optional co-branding shown next to each company's own logo in the app header.
# VITE_PLATFORM_LOGO_URL can point at a file in frontend/public/ (e.g. /platform-logo.png)
# once you've picked a name/logo — until then it just shows "Powered by {VITE_PLATFORM_NAME}".
VITE_PLATFORM_NAME=Platform
VITE_PLATFORM_LOGO_URL=
