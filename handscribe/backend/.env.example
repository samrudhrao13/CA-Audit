# Google Cloud Vision API key. Get it from: Google Cloud Console > APIs &
# Services > Credentials > Create Credentials > API Key. Restrict it to the
# Cloud Vision API. The project it belongs to must have billing enabled
# (Vision API requires this even within the free tier).
GOOGLE_VISION_API_KEY=your-google-vision-api-key-here

# Which LLM structuring provider to use: "groq", "gemini", or "vertex".
# Only the settings for whichever provider is selected need to be filled in.
LLM_PROVIDER=groq

# Groq API key. Get it from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Optional: override the Groq model (default shown). We benchmarked
# alternatives on ambiguous-field disambiguation: qwen/qwen3.6-27b and
# openai/gpt-oss-120b were both MORE accurate (qwen especially), but on a
# free/on-demand Groq account they're capped at 8000 tokens/minute, which
# a full multi-field extraction with reasoning easily exceeds — llama-3.3
# has a much higher per-minute ceiling (its limit is a 100k/day cap
# instead), so it's the one that actually works at real template sizes.
# If you upgrade to a paid Groq tier, qwen/qwen3.6-27b is worth trying —
# it was more reliable in our tests, just needs the higher TPM headroom.
GROQ_MODEL=llama-3.3-70b-versatile

# Max tokens the model is allowed to generate per request. Groq reserves
# this amount against your account's tokens-per-minute limit up front
# (not just what's actually used), and that limit varies noticeably by
# account/tier — if you see a 413 "Request too large... TPM" error, lower
# this. llama-3.3-70b-versatile reasons concisely so the default is plenty;
# bump this much higher (8000+) only if you switch to a verbose "thinking"
# model like qwen/qwen3.6-27b, which can otherwise get cut off mid-answer.
GROQ_MAX_COMPLETION_TOKENS=4096

# Gemini API key (Google AI Studio, not full Vertex AI — a plain API key,
# no service account needed). Get it from: https://aistudio.google.com/apikey
# Only required when LLM_PROVIDER=gemini.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: override the Gemini model (default shown). Using the
# "-latest" alias rather than a pinned version so this doesn't silently
# go stale — gemini-2.0-flash, our original default, was already
# superseded by gemini-2.5-flash and newer by the time we tested this
# for real. Pin an explicit version instead if you want reproducible
# behavior across Google's model updates.
GEMINI_MODEL=gemini-flash-latest

# --- Vertex AI (only required when LLM_PROVIDER=vertex) ---
# GCP project ID with the Vertex AI API enabled and billing linked.
GOOGLE_VERTEX_PROJECT_ID=your-gcp-project-id

# Region to call Vertex AI in (default shown).
GOOGLE_VERTEX_LOCATION=us-central1

# Optional: override the Vertex Gemini model (default shown).
GOOGLE_VERTEX_MODEL=gemini-2.0-flash-001

# Path to a Vertex AI service account JSON key (needs the "Vertex AI User"
# role). Get it from: Google Cloud Console > IAM & Admin > Service Accounts
# > (your service account) > Keys > Add Key > Create new key (JSON).
# Save it outside of git (e.g. backend/secrets/, which is gitignored).
GOOGLE_APPLICATION_CREDENTIALS=./secrets/vertex-service-account.json

# Optional: which OCRProvider implementation to use. Currently only
# "google_vision" is implemented; add new providers under app/ocr/.
OCR_PROVIDER=google_vision

# Database connection string. Defaults to a local SQLite file. To move to
# PostgreSQL later (e.g. on Railway), just change this — no code changes
# needed. Example: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./handscribe.db

# Comma-separated list of origins allowed to call this API (your frontend URL).
CORS_ORIGINS=http://localhost:3000

# Optional: max upload size in MB for handwriting images.
MAX_UPLOAD_MB=10
